# 299Trust — copy to .env and fill in. NEVER commit the real .env.
# Values come from Supabase Dashboard -> Project Settings -> API.

# --- App / client (safe to ship in the mobile app) ---
SUPABASE_URL=https://fdrdecpzihlztncvglwx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # the "publishable" key; RLS protects data

# --- Server only: Edge Function secrets (set via `supabase secrets set`) ---
# DO NOT put these in the app bundle or commit them.
SUPABASE_SERVICE_ROLE_KEY=           # service_role key — bypasses RLS
FORMSTACK_WEBHOOK_SECRET=            # random string; appended to the webhook URL as ?secret=

# --- Formstack ---
FORMSTACK_FORM_ID=
FORMSTACK_API_TOKEN=                 # only needed for API submit (V2 AI intake)

# --- AI (V2, unused in V1) ---
ANTHROPIC_API_KEY=
